<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MoveWindowToDesktop</AssemblyName>
    <RootNamespace>MoveWindowToDesktop</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Single exe; the native VirtualDesktopAccessor.dll is bundled and self-extracted -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- https://github.com/Ciantic/VirtualDesktopAccessor (MIT). Update this file when a new Windows build breaks it. -->
    <Content Include="VirtualDesktopAccessor.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
